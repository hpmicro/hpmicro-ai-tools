{
  "name": "@hpmicro-tools/hpmsdkctl",
  "version": "0.0.1",
  "description": "HPM SDK CLI and stdio MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpmicro/hpmicro-ai-tools.git",
    "directory": "mcp-servers/hpmsdkctl"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hpmsdkctl": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "15.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1"
  }
}
